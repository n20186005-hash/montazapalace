---
import Layout from './Layout.astro';
import NumericText from './NumericText.astro';
import { text, photos, sources, SITE, MAP, GEO, CHECKED, type Language } from '../data/site';
const { lang = 'ar' } = Astro.props as { lang: Language }; const t = text[lang]; const en = lang === 'en'; const path = en ? '/en/' : '/';
const schema = [
 { '@context': 'https://schema.org', '@type': 'TouristAttraction', '@id': SITE+'/#attraction', name: 'Montaza Palace', alternateName: ['قصر المنتزه','Montazah Palace'], url: SITE+'/', hasMap: MAP, geo: { '@type':'GeoCoordinates', ...GEO }, address: { '@type':'PostalAddress', streetAddress:'El-Gaish Rd, Al Mandarah Bahri, Montaza 2', addressLocality:'Alexandria', addressRegion:'Alexandria Governorate', postalCode:'5527001', addressCountry:'EG' }, image: photos.map(p=>SITE+'/images/montaza-palace-'+p.file+'.jpg') },
 { '@context':'https://schema.org', '@type':'WebSite', '@id':SITE+'/#website', url:SITE+'/', name:'Montaza Palace Guide', inLanguage:['ar','en'], description:t.positioning },
 { '@context':'https://schema.org', '@type':'WebPage', '@id':SITE+path, url:SITE+path, name:t.title, description:t.description, inLanguage:lang, dateModified:CHECKED, about:{'@id':SITE+'/#attraction'}, isPartOf:{'@id':SITE+'/#website'} },
 { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:t.faq.map(([question,answer])=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}})) }
];
---
<Layout lang={lang} title={t.title} description={t.description} path={path} alternate={en ? '/' : '/en/'} image="/images/montaza-palace-hero.jpg" imageAlt={photos[0][lang]}>
 <main id="main"><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <section class="home-hero"><img class="hero-photo" src="/images/montaza-palace-hero.jpg" width="4388" height="3185" alt={photos[0][lang]} fetchpriority="high" decoding="async"/><div class="hero-shade"></div><div class="container-shell hero-copy"><p class="section-kicker">{en ? 'Alexandria · Royal gardens and palaces' : 'الإسكندرية · حدائق وقصور ملكية سابقة'}</p><h1>{t.name}<span>{en ? 'Gardens, access and planning' : 'الحدائق والزيارة والتخطيط'}</span></h1><p class="hero-lead">{t.lead}</p><div class="hero-buttons"><a href="#visit">{t.plan}</a><a href={MAP} rel="noopener noreferrer" target="_blank">{t.map} ↗</a></div><p class="hero-credit"><a href={'https://commons.wikimedia.org/wiki/File:'+photos[0].title}>Ayman G. Abdeltawab</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · <bdi dir="ltr">2016-09-06</bdi> · {t.credit}</p></div></section>
  <section class="facts-section"><div class="container-shell fact-grid">{t.facts.map(([label,value,note])=><article class="arch-card"><p class="section-kicker">{label}</p><h2>{value.includes('08:') ? <bdi dir="ltr">{value}</bdi> : value}</h2><p><NumericText value={note}/></p></article>)}</div></section>
  <section id="about" class="content-section"><div class="container-shell two-column"><div><p class="section-kicker">{en ? 'Understand the estate' : 'تعرّف على المكان'}</p><h2 class="section-title">{t.aboutTitle}</h2></div><div>{t.about.map(p=><p class="section-copy">{p}</p>)}<p class="editorial-date">{t.updated}</p></div></div></section>
  <section id="story" class="content-section"><div class="container-shell two-column story-grid"><figure><img src="/images/montaza-palace-main.jpg" width="3968" height="2976" alt={photos[1][lang]} loading="lazy" decoding="async"/><figcaption><a href={'https://commons.wikimedia.org/wiki/File:'+photos[1].title}>{photos[1].author}</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · <bdi dir="ltr">2019-08-15</bdi> · {t.credit}</figcaption></figure><div><p class="section-kicker">{en ? 'Historic context' : 'خلفية تاريخية'}</p><h2 class="section-title">{t.storyTitle}</h2>{t.story.map(p=><p class="section-copy">{p}</p>)}</div></div></section>
  <section class="gallery-section"><div class="container-shell"><h2 class="section-title">{t.galleryTitle}</h2><p>{t.galleryIntro}</p><div class="photo-grid-new">{photos.slice(2).map(p=><figure><img src={'/images/montaza-palace-'+p.file+'.jpg'} width={p.width} height={p.height} alt={p[lang]} loading="lazy" decoding="async"/><figcaption><p>{p[lang]}</p><a href={'https://commons.wikimedia.org/wiki/File:'+p.title}>{p.author}</a> · <a href={'https://creativecommons.org/licenses/by-sa/'+p.version+'/'}>{p.license}</a> · <bdi dir="ltr">{p.date}</bdi> · {t.credit}</figcaption></figure>)}</div></div></section>
  <section id="visit" class="content-section"><div class="container-shell"><h2 class="section-title">{t.visitTitle}</h2><div class="three-column">{t.visitCards.map(([title,body])=><article class="arch-card"><h3>{title}</h3><p><NumericText value={body}/></p></article>)}</div></div></section>
  <section id="transport" class="transport-section"><div class="container-shell"><h2 class="section-title">{t.transportTitle}</h2><p class="wide-lead">{t.transport}</p><div class="three-column">{t.transportCards.map(([title,body])=><article><h3>{title}</h3><p><NumericText value={body}/></p></article>)}</div></div></section>
  <section id="nearby" class="content-section"><div class="container-shell"><h2 class="section-title">{t.nearbyTitle}</h2><div class="three-column">{t.nearby.map(([title,body])=><article class="arch-card"><h3>{title}</h3><p><NumericText value={body}/></p></article>)}</div></div></section>
  <section id="map" class="content-section"><div class="container-shell map-layout"><div><h2 class="section-title">{t.mapTitle}</h2><address>{en ? 'El-Gaish Rd, Al Mandarah Bahri, Montaza 2, Alexandria Governorate 5527001, Egypt' : 'طريق الجيش، المندرة بحري، المنتزه 2، الإسكندرية 5527001، مصر'}</address><p><bdi dir="ltr">{GEO.latitude}, {GEO.longitude}</bdi> · <bdi dir="ltr">72Q8+99</bdi></p><p><NumericText value={t.rating}/></p><a href={MAP} target="_blank" rel="noopener noreferrer">{t.map} ↗</a></div><iframe src="https://www.google.com/maps?q=31.2884642,30.0159916&output=embed" title={en ? 'Montaza Palace place location' : 'موقع قصر المنتزه'} width="600" height="460" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
  <section id="faq" class="faq-section"><div class="container-shell"><h2 class="section-title">{t.faqTitle}</h2><div class="faq-list">{t.faq.map(([q,a])=><details><summary>{q}</summary><p><NumericText value={a}/></p></details>)}</div></div></section>
  <section id="sources" class="sources-section"><div class="container-shell"><h2 class="section-title">{t.sourcesTitle}</h2><p>{t.sourceNote}</p><ul>{sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s[lang]} ↗</a></li>)}</ul></div></section>
 </main>
</Layout>
