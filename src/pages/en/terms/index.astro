---
import '../../../styles/global.css';
const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://montazapalace.com';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const arUrl = `${site}/terms/`;
const enUrl = `${site}/en/terms/`;
---
<!doctype html><html lang="en" dir="ltr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#073f45"/><title>Terms of Use | Montaza Palace Guide</title><meta name="description" content="Terms of use for the independent Montaza Palace (قصر المنتزه) visitor guide: planning information, variable details and third-party links."/>{canonicalUrl && <link rel="canonical" href={canonicalUrl}/>}<link rel="alternate" hreflang="ar" href={arUrl}/><link rel="alternate" hreflang="en" href={enUrl}/><link rel="alternate" hreflang="x-default" href={arUrl}/><link rel="manifest" href="/site.webmanifest"/><link rel="icon" href="/brand/favicon.svg" type="image/svg+xml"/></head><body class="policy-body"><main class="policy-shell"><a class="policy-back" href="/en/">← Back to guide</a> <span aria-hidden="true">·</span> <a class="policy-back" href="/terms/" lang="ar" hreflang="ar">العربية</a><img src="/brand/logo.svg" alt="Montaza Palace" class="mt-8 h-14 w-auto"/><h1>Terms of Use</h1><p>The content here is for general travel planning and is not an official announcement about operation, ticketing, or opening of the palace buildings.</p><h2>Information that changes</h2><p>Fees, entry hours, parking, building availability and services can change. Verify the published instructions at the gate or with the relevant authority before making a decision that relies on these details.</p><h2>Maps and links</h2><p>Google links and maps are provided for convenience, and third-party services are subject to their providers' terms.</p><h2>Photographs</h2><p>The photographs are documented in the <code>PHOTO-SOURCES.md</code> file in the project, and attribution and license must be preserved when reusing them.</p><h2>Unofficial status</h2><p>The site is an independent guide and is not affiliated with the Presidency, the Ministry of Tourism and Antiquities, or the Montaza Gardens administration.</p></main></body></html>
