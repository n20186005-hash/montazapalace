---
import '../../../styles/global.css';
const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://montazapalace.com';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const arUrl = `${site}/privacy/`;
const enUrl = `${site}/en/privacy/`;
---
<!doctype html><html lang="en" dir="ltr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#073f45"/><title>Privacy Policy | Montaza Palace Guide</title><meta name="description" content="Privacy policy for the independent Montaza Palace (قصر المنتزه) visitor guide: analytics consent, third-party services and local storage."/>{canonicalUrl && <link rel="canonical" href={canonicalUrl}/>}<link rel="alternate" hreflang="ar" href={arUrl}/><link rel="alternate" hreflang="en" href={enUrl}/><link rel="alternate" hreflang="x-default" href={arUrl}/><link rel="manifest" href="/site.webmanifest"/><link rel="icon" href="/brand/favicon.svg" type="image/svg+xml"/></head><body class="policy-body"><main class="policy-shell"><a class="policy-back" href="/en/">← Back to guide</a> <span aria-hidden="true">·</span> <a class="policy-back" href="/privacy/" lang="ar" hreflang="ar">العربية</a><img src="/brand/logo.svg" alt="Montaza Palace" class="mt-8 h-14 w-auto"/><h1>Privacy Policy</h1><p>This is an independent visitor guide to the Montaza Palace and gardens. It does not require account creation and does not store a database of visitors.</p><h2>Analytics</h2><p>The site uses Google Analytics 4 with the identifier <code>G-HXM22WWPKP</code> only if you choose to allow analytics cookies from the cookie settings page. You can change your decision at any time.</p><h2>Third-party services</h2><p>The page embeds a Google Map and displays photographs with documented sources. When third-party content loads, the provider may receive usual technical data such as IP address and browser information under its own policies.</p><h2>Local storage</h2><p>The browser's local storage is used to remember your analytics choice. The site does not use this choice to build a profile or to log you in.</p><h2>Disclaimer</h2><p>This site is unofficial and is not affiliated with the Montaza Gardens administration or any government body.</p></main></body></html>
