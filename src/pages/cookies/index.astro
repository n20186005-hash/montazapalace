---
import '../../styles/global.css';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#073f45"/><title>إعدادات ملفات تعريف الارتباط | دليل قصر المنتزه</title>{canonicalUrl && <link rel="canonical" href={canonicalUrl}/>}<link rel="icon" href="/brand/favicon.svg" type="image/svg+xml"/></head><body class="policy-body"><main class="policy-shell"><a class="policy-back" href="/">← العودة إلى الدليل</a><img src="/brand/logo.svg" alt="قصر المنتزه" class="mt-8 h-14 w-auto"/><h1>إعدادات ملفات تعريف الارتباط</h1><p>ملفات التشغيل الضرورية لا تُستخدم للتتبع. التحليلات اختيارية ويمكنك السماح بها أو رفضها أدناه.</p><div class="mt-8 grid gap-4 sm:grid-cols-2"><button id="allow" class="rounded-2xl bg-[#073f45] px-6 py-4 font-black text-white">السماح بالتحليلات</button><button id="deny" class="rounded-2xl border border-[#073f45]/25 bg-white px-6 py-4 font-black text-[#073f45]">رفض التحليلات</button></div><p id="status" class="mt-5 rounded-2xl bg-[#efe4cc] p-4 text-sm"></p><h2>ما الذي يتغير؟</h2><p>عند السماح، يستطيع الموقع تحميل Google Analytics 4. عند الرفض لا يتم تحميل سكربت التحليلات من الصفحة الرئيسية.</p></main><script is:inline>
const key='montaza-analytics-consent';
const status=document.getElementById('status');
function render(){const v=localStorage.getItem(key); status.textContent=v==='granted'?'اختيارك الحالي: السماح بالتحليلات.':v==='denied'?'اختيارك الحالي: رفض التحليلات.':'لم يتم اختيار تفضيل بعد.';}
document.getElementById('allow').addEventListener('click',()=>{localStorage.setItem(key,'granted');render();});
document.getElementById('deny').addEventListener('click',()=>{localStorage.setItem(key,'denied');render();});
render();
</script></body></html>
