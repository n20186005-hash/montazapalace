---
import '../styles/global.css';

const SITE = 'https://montazapalace.com';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `${SITE}/`;

// === كيان واحد (Single Entity) ===
// مصدر واحد للحقيقة: نفس الاسم والعنوان والإحداثيات يُستهلكان في وسوم الرأس والبيانات المنظمة والنص المرئي
// للحفاظ على تطابق NAP (الاسم/العنوان) مع قائمة المكان على خرائط Google.
const entity = {
  name: 'Montaza Palace',
  nameAr: 'قصر المنتزه',
  aliasAr: 'المنتزه',
  city: 'الإسكندرية',
  cityEn: 'Alexandria',
  region: 'محافظة الإسكندرية',
  regionEn: 'Alexandria Governorate',
  country: 'مصر',
  countryEn: 'Egypt',
  countryCode: 'EG',
  postalCode: '5527001',
  street: 'طريق الجيش، المندرة بحري، المنتزه 2',
  streetEn: 'El-Gaish Rd, Al Mandarah Bahri, Montaza 2',
  latitude: 31.288468758560075,
  longitude: 30.013416677163775,
  plusCode: '72Q8+99',
  ratingValue: '4.5',
  ratingCount: '19045',
  mapUrl: 'https://maps.app.goo.gl/q697EC591sWcm8yh8',
  tourismUrl: 'https://www.experienceegypt.eg/',
  ministryUrl: 'https://mota.gov.eg/',
  wikipedia: 'https://en.wikipedia.org/wiki/Montaza_Palace',
  wikidata: 'https://www.wikidata.org/wiki/Q1350295',
  commons: 'https://commons.wikimedia.org/wiki/Category:Montaza_Palace'
};

const mapUrl = entity.mapUrl;
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6059.946987210147!2d30.013416677163775!3d31.288468758560075!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14f5d05ef533eccb%3A0xae82154762ef9858!2sMontaza%20Palace!5e1!3m2!1sar!2seg!4v1789018679731!5m2!1sar!2seg';

// صور حقيقية للمكان موطّنة داخل النطاق نفسه (تخدم og:image والبيانات المنظمة وعرض الصفحة).
const photos = {
  hero: '/images/montaza-palace-hero.jpg',
  palace: '/images/montaza-palace-main.jpg',
  garden: '/images/montaza-palace-garden.jpg',
  coast: '/images/montaza-palace-coast.jpg'
};

const abs = (path: string) => new URL(path, SITE).href;
const pageUrl = canonicalUrl || `${SITE}/`;
const attractionId = `${SITE}/#attraction`;
const websiteId = `${SITE}/#website`;
const organizationId = `${SITE}/#organization`;
const ogImage = abs(photos.hero);
const heroImageAlt = `${entity.nameAr} (${entity.name}) — المنظر الرئيسي في ${entity.city}، ${entity.country}`;
const socialTitle = `${entity.nameAr} (${entity.name}) - Alexandria Visitor Guide & Location`;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness', 'LandmarksOrHistoricalBuildings'],
  '@id': attractionId,
  name: entity.name,
  alternateName: [entity.nameAr, 'Montazah Palace', `${entity.name} ${entity.cityEn}`, `${entity.nameAr} ${entity.city}`],
  description: `دليل عربي مستقل لزيارة قصر وحدائق المنتزه الملكية على ساحل ${entity.city}، ${entity.country} — Montaza Palace visitor guide.`,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  image: [abs(photos.hero), abs(photos.palace), abs(photos.garden), abs(photos.coast)],
  isAccessibleForFree: false,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${entity.street} (${entity.streetEn})`,
    addressLocality: `${entity.city} / ${entity.cityEn}`,
    addressRegion: `${entity.region} / ${entity.regionEn}`,
    postalCode: entity.postalCode,
    addressCountry: entity.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: entity.latitude,
    longitude: entity.longitude
  },
  hasMap: entity.mapUrl,
  sameAs: [entity.mapUrl, entity.wikipedia, entity.wikidata, entity.commons, entity.tourismUrl, entity.ministryUrl],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '08:00',
    closes: '23:00'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: entity.ratingValue,
    ratingCount: entity.ratingCount,
    bestRating: '5'
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Plus Code', value: `${entity.plusCode} ${entity.city}` }
  ]
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${SITE}/`,
  name: 'دليل قصر المنتزه · Montaza Palace Guide',
  alternateName: 'Montaza Palace Guide',
  inLanguage: ['ar', 'en'],
  publisher: { '@id': organizationId },
  about: { '@id': attractionId }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: 'دليل قصر المنتزه (Montaza Palace Guide)',
  url: `${SITE}/`,
  logo: { '@type': 'ImageObject', url: `${SITE}/brand/logo.svg` },
  description: 'موقع إرشادي مستقل وغير رسمي عن قصر وحدائق المنتزه في الإسكندرية.',
  sameAs: [entity.wikipedia, entity.wikidata, entity.commons]
};

// تسلسل جغرافي مرئي مطابق لتسلسل الاسم الرسمي → المدينة → المحافظة → الدولة.
const geoHierarchy = [entity.nameAr, entity.city, entity.region, entity.country];

// روابط المصادر الموثوقة (E-E-A-T) المستخدمة في قسم المصادر وفي sameAs.
const sources = [
  { label: 'قائمة المكان على خرائط Google', labelEn: 'Google Maps place listing', url: entity.mapUrl, note: `${entity.plusCode} · ${entity.city}` },
  { label: 'بوابة السياحة الرسمية في مصر (هيئة تنشيط السياحة)', labelEn: 'Egypt Tourism Authority (Experience Egypt)', url: entity.tourismUrl, note: entity.countryEn },
  { label: 'وزارة السياحة والآثار', labelEn: 'Ministry of Tourism and Antiquities', url: entity.ministryUrl, note: entity.countryEn },
  { label: 'ويكيبيديا — Montaza Palace', labelEn: 'Wikipedia — Montaza Palace', url: entity.wikipedia, note: entity.cityEn },
  { label: 'Wikidata — Montaza Palace (Q1350295)', labelEn: 'Wikidata entity Q1350295', url: entity.wikidata, note: 'Knowledge Graph' },
  { label: 'Wikimedia Commons — تصنيف قصر المنتزه', labelEn: 'Wikimedia Commons category', url: entity.commons, note: 'Photos' }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'montazapalace.com', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: `${entity.nameAr} (${entity.name})`, item: pageUrl }
  ]
};

const faqItems = [
  {
    question: 'هل يمكن دخول قصر الحرملك من الداخل؟',
    answer: 'لا تفترض أن مباني القصر الداخلية مفتوحة دائمًا للزيارة العامة؛ بعض أجزاء المجمع ذات استخدام رسمي أو تخضع لترتيبات خاصة. خطط للزيارة على أساس الحدائق والمشاهد الخارجية، واسأل عند البوابة عن أي فتح استثنائي.'
  },
  {
    question: 'كم أحتاج من الوقت لزيارة المنتزه؟',
    answer: 'زيارة مريحة للحدائق والواجهات الساحلية ونقاط التصوير تحتاج عادةً نحو ساعتين ونصف إلى أربع ساعات، ويمكن أن تمتد أكثر إذا أضفت استراحة أو شاطئًا قريبًا.'
  },
  {
    question: 'ما أفضل وقت للتصوير؟',
    answer: 'الصباح الباكر يمنحك هدوءًا وضوءًا لطيفًا، بينما الساعات التي تسبق الغروب مناسبة للواجهات الملكية والبحر. في الصيف يفضّل تجنب منتصف النهار بسبب الحرارة.'
  },
  {
    question: 'هل توجد رسوم دخول؟',
    answer: 'توجد رسوم لدخول الحدائق، وقد تتغير الأسعار والخدمات الإضافية. ورد سعر إرشادي قدره 50 جنيهًا للفرد في تقارير محلية حديثة؛ تحقّق من السعر المعلن عند البوابة يوم زيارتك.'
  },
  {
    question: 'هل المكان مناسب للعائلات وكبار السن؟',
    answer: 'المساحات المفتوحة واسعة ومناسبة للعائلات، لكن المسافات داخل الحدائق قد تكون طويلة. ارتدِ حذاءً مريحًا واسأل عن وسائل التنقل الداخلية المتاحة عند الوصول.'
  },
  {
    question: 'أين يقع قصر المنتزه (Montaza Palace) بالتحديد؟',
    answer: 'يقع قصر المنتزه في شرق الإسكندرية على طريق الجيش بمنطقة المندرة بحري (المنتزه 2)، ورمز المكان على خرائط Google هو 72Q8+99. يمكن فتح الموقع والاتجاهات مباشرة من رابط الخريطة داخل هذه الصفحة.'
  },
  {
    question: 'كيف أصل إلى قصر المنتزه بالمواصلات العامة؟',
    answer: 'أقرب خيار معتاد هو قطار أبو قير المحلي مع النزول في محطة المنتزه ثم إكمال مسافة قصيرة إلى البوابات، كما تعمل الميكروباصات والحافلات على الكورنيش باتجاه المندرة والمعمورة وأبو قير. راجع حالة تشغيل الخط يوم الرحلة.'
  },
  {
    question: 'هل يُسمح بالتصوير داخل المنتزه؟',
    answer: 'التصوير الشخصي للحدائق والواجهات الخارجية أمر معتاد، لكن قد توجد قيود على التصوير التجاري أو بالمعدات الكبيرة أو قرب المباني ذات الاستخدام الرسمي. اسأل الحراسة عند البوابة قبل استخدام معدات احترافية.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const title = `قصر المنتزه (${entity.name}) في ${entity.city} | دليل الزيارة والموقع`;
const description = `دليل زيارة قصر المنتزه (${entity.name}) في ${entity.city}، ${entity.country}: الموقع والخريطة، المواعيد والرسوم، أفضل وقت للزيارة، الوصول بالسيارة والقطار، ومعالم قريبة مثل جزيرة الشاي وشاطئ المعمورة.`;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b5960" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <title>{title}</title>

    <!-- Canonical + hreflang: يمنع تشتّت الوزن بين روابط المعاملات ويوحّد عنوان المنشأ -->
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="ar-eg" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Geo / NAP: نفس الاسم والعنوان والإحداثيات المستخدمة في قائمة خرائط Google -->
    <meta name="geo.region" content="EG-ALX" />
    <meta name="geo.placename" content={`${entity.cityEn}, ${entity.countryEn}`} />
    <meta name="geo.position" content={`${entity.latitude};${entity.longitude}`} />
    <meta name="ICBM" content={`${entity.latitude}, ${entity.longitude}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="دليل قصر المنتزه · Montaza Palace Guide" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="4388" />
    <meta property="og:image:height" content="3185" />
    <meta property="og:image:alt" content={heroImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={heroImageAlt} />

    <!-- PWA -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="دليل قصر المنتزه" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="المنتزه" />

    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

    <script is:inline>
      (() => {
        if (localStorage.getItem('montaza-analytics-consent') !== 'granted') return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
        document.head.appendChild(script);
      })();
    </script>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <header class="absolute inset-x-0 top-0 z-40 border-b border-white/15 bg-[#073f45]/20 backdrop-blur-md">
      <div class="container-shell flex h-20 items-center justify-between gap-5">
        <a href="#top" class="flex items-center gap-3" aria-label="العودة إلى بداية الصفحة">
          <img src="/brand/logo.svg" alt="شعار قصر المنتزه" class="h-12 w-auto" width="206" height="52" />
        </a>
        <nav class="hidden items-center gap-6 text-sm font-bold text-white/90 md:flex" aria-label="التنقل الرئيسي">
          <a href="#about" class="hover:text-white">التعريف</a>
          <a href="#story" class="hover:text-white">الحكاية</a>
          <a href="#visit" class="hover:text-white">خطط الزيارة</a>
          <a href="#transport" class="hover:text-white">الوصول</a>
          <a href="#nearby" class="hover:text-white">حول المنتزه</a>
          <a href="#faq" class="hover:text-white">الأسئلة</a>
        </nav>
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/45 px-4 py-2 text-sm font-extrabold text-white transition hover:bg-white hover:text-[#073f45]">
          افتح الخريطة
        </a>
      </div>
    </header>

    <main id="top">
      <section class="relative flex min-h-[92svh] items-end overflow-hidden bg-[#073f45]">
        <img
          src={photos.hero}
          alt={heroImageAlt}
          class="absolute inset-0 h-full w-full object-cover object-center"
          width="4388"
          height="3185"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(4,37,40,.20),rgba(4,37,40,.56)_45%,rgba(4,37,40,.94))]"></div>
        <div class="absolute inset-x-0 bottom-0 h-44 opacity-25 palace-pattern"></div>

        <div class="container-shell relative z-10 pb-16 pt-40 text-white md:pb-24">
          <div class="mb-7 flex flex-wrap items-center gap-3 text-sm font-bold">
            <span class="rounded-full border border-white/30 bg-white/10 px-4 py-2 backdrop-blur">الإسكندرية · البحر المتوسط</span>
            <span class="rounded-full border border-[#d9b76b]/60 bg-[#d9b76b]/10 px-4 py-2 text-[#ffe5a9]">★ 4.5 · 19,045 تقييمًا</span>
          </div>
          <p class="mb-3 text-sm font-black tracking-[.23em] text-[#e9c97d]">قصر وحدائق ملكية على طرف المدينة</p>
          <h1 class="max-w-4xl text-[clamp(3.7rem,10vw,8.6rem)] font-black leading-[.86] tracking-[-.055em]">
            قصر<br />المنتزه
            <span class="mt-4 block text-[clamp(1rem,2.6vw,1.7rem)] font-black leading-snug tracking-normal text-white/85">Montaza Palace · الإسكندرية</span>
          </h1>
          <div class="mt-9 grid max-w-4xl gap-7 border-t border-white/20 pt-7 md:grid-cols-[1.4fr_.8fr]">
            <p class="max-w-2xl text-lg leading-8 text-white/84 md:text-xl">
              حدائق واسعة، عمارة ملكية بطابع متوسطي، وممرات تنفتح على البحر. هذا الدليل يساعدك على زيارة المنتزه كما هو: مكان للتنزّه والتصوير قبل أن يكون مجرد «قصر» خلف بوابة.
            </p>
            <div class="flex items-start gap-3 md:justify-end">
              <span class="mt-1 text-2xl text-[#e9c97d]">⌖</span>
              <p class="max-w-xs text-sm leading-7 text-white/78">طريق الجيش، المندرة بحري، المنتزه 2، محافظة الإسكندرية</p>
            </div>
          </div>
          <p class="photo-credit absolute bottom-3 left-0 rounded-e-full px-4 py-1.5">صورة حقيقية · Wikimedia Commons · Ayman G. Abdeltawab</p>
        </div>
      </section>

      <section class="relative z-20 -mt-7 pb-24">
        <div class="container-shell grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <article class="arch-card rounded-[2rem] p-6">
            <div class="info-icon mb-5">◷</div>
            <p class="text-xs font-black tracking-[.14em] text-[#8f3d32]">الساعات الإرشادية</p>
            <p class="mt-2 text-2xl font-black">08:00–23:00</p>
            <p class="mt-1 text-sm text-[#667573]">تحقّق يوم الزيارة؛ قد تتغير المواعيد.</p>
          </article>
          <article class="arch-card rounded-[2rem] p-6">
            <div class="info-icon mb-5">ج.م</div>
            <p class="text-xs font-black tracking-[.14em] text-[#8f3d32]">رسم إرشادي للحدائق</p>
            <p class="mt-2 text-2xl font-black">50 جنيهًا</p>
            <p class="mt-1 text-sm text-[#667573]">سعر متداول حديثًا، وليس ضمانًا للسعر الحالي.</p>
          </article>
          <article class="arch-card rounded-[2rem] p-6">
            <div class="info-icon mb-5">⌛</div>
            <p class="text-xs font-black tracking-[.14em] text-[#8f3d32]">مدة مقترحة</p>
            <p class="mt-2 text-2xl font-black">2.5–4 ساعات</p>
            <p class="mt-1 text-sm text-[#667573]">للتنزّه، البحر، الصور والاستراحة.</p>
          </article>
          <article class="arch-card rounded-[2rem] p-6">
            <div class="info-icon mb-5">☀</div>
            <p class="text-xs font-black tracking-[.14em] text-[#8f3d32]">أفضل ضوء</p>
            <p class="mt-2 text-2xl font-black">صباحًا أو قبل الغروب</p>
            <p class="mt-1 text-sm text-[#667573]">ألطف للمشي وأجمل للواجهات الساحلية.</p>
          </article>
        </div>
      </section>

      <section id="about" class="pb-24">
        <div class="container-shell">
          <nav aria-label="مسار التنقل والانتماء الجغرافي" class="border-b border-[#0b5960]/12 pb-5">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold text-[#8b9a97]">
              <li><a href="/" class="hover:text-[#0b5960]">montazapalace.com</a></li>
              <li aria-hidden="true">›</li>
